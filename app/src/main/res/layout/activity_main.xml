<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#08090D">

    <LinearLayout android:id="@+id/main" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:paddingLeft="22dp" android:paddingRight="18dp">
            <TextView android:id="@+id/menu" android:text="☰" android:textSize="34sp" android:textColor="#FFFFFF" android:layout_width="58dp" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/title" android:text="New chat" android:textSize="28sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/more" android:text="⋮" android:textSize="34sp" android:textColor="#FFFFFF" android:layout_width="42dp" android:gravity="center" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/status" android:text="●  Ready" android:textSize="16sp" android:textColor="#8D909D" android:paddingLeft="38dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                <LinearLayout android:id="@+id/messages" android:orientation="vertical" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="10dp" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/mic" android:text="🎙" android:textSize="25sp" android:gravity="center" android:layout_width="52dp" android:layout_height="58dp"/>
            <EditText android:id="@+id/input" android:hint="Message MyAssistant..." android:textColor="#FFFFFF" android:hintTextColor="#7F8290" android:textSize="18sp" android:singleLine="false" android:background="@drawable/bg_input" android:paddingLeft="20dp" android:paddingRight="20dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="58dp"/>
            <TextView android:id="@+id/send" android:text="➤" android:textSize="30sp" android:textColor="#FFFFFF" android:gravity="center" android:background="@drawable/bg_send" android:layout_marginLeft="10dp" android:layout_width="58dp" android:layout_height="58dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/sidebar" android:visibility="gone" android:orientation="vertical" android:background="@drawable/bg_sidebar" android:elevation="20dp" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="28dp" android:layout_width="78%" android:layout_height="match_parent">
        <TextView android:text="✦  MyAssistant" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="27sp" android:layout_width="match_parent" android:layout_height="58dp"/>
        <TextView android:id="@+id/newChat" android:text="+  New chat" android:textColor="#FFFFFF" android:textSize="19sp" android:gravity="center" android:background="#30284F" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="64dp"/>
        <TextView android:text="RECENT CHATS" android:textColor="#7F8290" android:textSize="14sp" android:layout_marginTop="34dp" android:layout_width="match_parent" android:layout_height="35dp"/>
        <LinearLayout android:id="@+id/chatList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
